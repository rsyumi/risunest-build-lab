{
  "identifier": "desktop-capability",
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ],
  "permissions": [
    "core:window:allow-destroy",
    "process:default",
    "shell:default",
    "http:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "deep-link:default"
  ]
}
